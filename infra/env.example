# =============================================================================
# infra/env.example
# Copy to infra/.env and fill in real values. Never commit the real .env file.
# =============================================================================

# ---------- General ----------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=info

# ---------- PostgreSQL ----------
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=portal_db
POSTGRES_PORT=5432

# ---------- Backend (FastAPI) ----------
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://portal_user:changeme@postgres:5432/portal_db
SECRET_KEY=changeme-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (used for password resets / notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

# File storage (patient documents, uploads)
S3_BUCKET_NAME=portal-uploads-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---------- Patient Portal (frontend) ----------
PATIENT_PORTAL_PORT=3000
PATIENT_PORTAL_API_BASE_URL=http://localhost:8000

# ---------- Admin Portal (frontend) ----------
ADMIN_PORTAL_PORT=3001
ADMIN_PORTAL_API_BASE_URL=http://localhost:8000

# =============================================================================
# NOTE: The variable list above reflects a typical patient/admin portal stack
# (frontend x2, FastAPI backend, Postgres, email, and file storage). If your
# actual services list differs, paste it and I'll regenerate this file to
# match exactly — e.g. add REDIS_URL, SENTRY_DSN, STRIPE_SECRET_KEY,
# TWILIO_*, feature flags, or a third service, etc.
# =============================================================================
