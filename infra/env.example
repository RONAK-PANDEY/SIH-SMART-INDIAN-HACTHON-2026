# Environment Variables Template for SmartCare (SIH 2026)

# Database Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartcare
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartcare

# Redis Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=super-secret-sih2026-key-replace-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ABDM & ABHA Gateway Mock
ABDM_CLIENT_ID=sbx-abdm-client-id
ABDM_CLIENT_SECRET=sbx-abdm-secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# Notification API
SMS_GATEWAY_API_KEY=mock_sms_gateway_key
WHATSAPP_BUSINESS_TOKEN=mock_whatsapp_token
