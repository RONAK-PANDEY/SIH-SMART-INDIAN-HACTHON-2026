{
  "name": "sih-smart-indian-hackathon-2026",
  "version": "1.0.0",
  "private": true,
  "description": "SmartCare - AI-driven Intelligent OPD Queue & Triage Management System",
  "scripts": {
    "start:backend": "python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload --app-dir backend",
    "start:patient": "npm run dev --prefix patient-portal -- --port 5173 --host",
    "start:admin": "npm run dev --prefix admin-portal -- --port 5174 --host",
    "dev": "npm run start:patient",
    "build:patient": "npm run build --prefix patient-portal",
    "build:admin": "npm run build --prefix admin-portal",
    "build": "npm run build:patient && npm run build:admin",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.12",
    "typescript": "^5.2.2"
  }
}
