# SmartCare Backend Environment Variables
PROJECT_NAME="SmartCare OPD & Emergency AI Queue Engine"
API_V1_PREFIX="/api/v1"

# -------------------------------------------------------------
# Supabase Multi-Key Rotation Pool Configuration (6 Member Keys)
# -------------------------------------------------------------
SUPABASE_URL=https://smartcare-sih2026.supabase.co

# 1. Citizen / Patient Portal Pool (2 Keys in Round-Robin Rotation)
SUPABASE_KEY_PATIENT_1=your_supabase_patient_key_1_here # Member 1: Arpan
SUPABASE_KEY_PATIENT_2=your_supabase_patient_key_2_here # Member 2: Rishikesh

# 2. Doctor Consultation Console Pool (2 Keys in Round-Robin Rotation)
SUPABASE_KEY_DOCTOR_1=your_supabase_doctor_key_1_here # Member 3: Kartik
SUPABASE_KEY_DOCTOR_2=your_supabase_doctor_key_2_here # Member 4: Alok

# 3. National Vigilance & Observer Console Pool (Dedicated Key)
SUPABASE_KEY_OBSERVER=your_supabase_observer_key_here # Member 5: Ajay Kumar

# 4. Android QR Scanner Client Pool (Dedicated Key)
SUPABASE_KEY_SCANNER=your_supabase_scanner_key_here # Member 6: Shristi

SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# -------------------------------------------------------------
# Google Gemini Multi-Key Routing Pool (6 Free-Tier Keys)
# -------------------------------------------------------------
GEMINI_KEY_1=  # Member 1: Arpan
GEMINI_KEY_2=  # Member 2: Rishikesh
GEMINI_KEY_3=  # Member 3: Kartik
GEMINI_KEY_4=  # Member 4: Alok
GEMINI_KEY_5=  # Member 5: Ajay Kumar
GEMINI_KEY_6=  # Member 6: Shristi
GEMINI_RPM_LIMIT_PER_KEY=15

# PostgreSQL Connection String (Optional direct DB connection)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartcare

# Redis URL for distributed lock & fast queue cache (Optional in local dev)
REDIS_URL=redis://localhost:6379/0

# Security & Auth
JWT_SECRET=super-secret-sih2026-key-replace-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
